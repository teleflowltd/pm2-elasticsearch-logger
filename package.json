{
  "name": "pm2-elasticsearch-logger",
  "version": "3.0.0",
  "description": "Send PM2 logs to Elasticsearch",
  "main": "index.js",
  "files": [
    "index.js"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "npm run lint && node --throw-deprecation --test",
    "lint": "eslint .",
    "lintfix": "eslint . --fix",
    "package": "node scripts/package-release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teleflowltd/pm2-elasticsearch-logger.git"
  },
  "keywords": [
    "PM2",
    "Elasticsearch",
    "log"
  ],
  "config": {
    "elasticUrl": "http://localhost:9200",
    "index": "pm2",
    "type": "pm2",
    "host": "",
    "insecure": false
  },
  "apps": [
    {
      "name": "pm2-elasticsearch-logger",
      "script": "index.js",
      "pmx": false
    }
  ],
  "author": "Sebastian Raff <hobbyquaker@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/teleflowltd/pm2-elasticsearch-logger/issues"
  },
  "homepage": "https://github.com/teleflowltd/pm2-elasticsearch-logger#readme",
  "dependencies": {
    "@pm2/io": "^6.1.0",
    "pm2": "^7.0.4"
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "chokidar": "^5.0.0",
    "js-yaml": "^4.3.2"
  },
  "bundleDependencies": [
    "@pm2/io",
    "pm2"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
